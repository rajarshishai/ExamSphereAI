# =================================================================
# EXAMSPHERE AI - BACKEND CONFIGURATION
# =================================================================

# Server Port
PORT=5000

# MongoDB Database Connection
MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/examsphere?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_here

# AI Mentorship Services (OpenAI & Google Gemini)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=AIzaSy...

# =================================================================
# REAL GMAIL SMTP EMAIL DELIVERY CONFIGURATION
# =================================================================
# To send actual 6-digit OTP codes directly to user Gmail inboxes:
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Search for "App Passwords" and generate a 16-character password for "ExamSphere AI"
# 3. Paste your Gmail address and generated App Password below:

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
EMAIL_FROM_NAME="ExamSphere AI Authentication"

# =================================================================
# GOOGLE OAUTH 2.0 (GOOGLE SIGN-IN) CONFIGURATION
# =================================================================
# Optional: To enable official Google popup login (accounts.google.com):
# 1. Create a project at https://console.cloud.google.com
# 2. Go to APIs & Services > Credentials > Create Credentials > OAuth 2.0 Client ID
# 3. Application Type: Web application
# 4. Authorized JavaScript origins: http://localhost:4200
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
